# Copy to .env and edit. Never commit .env.

# Public name of this server (DNS A record -> the static IP). Caddy gets the HTTPS certificate for it.
RUNNER_HOST=cyberhealth.example.com
ACME_EMAIL=it@example.com

# First account, created on the first start only. It holds admin, analyst and reviewer roles.
RUNNER_ADMIN_EMAIL=you@example.com
RUNNER_ADMIN_PASSWORD=change-me-to-a-long-password
RUNNER_ADMIN_NAME=Your Name

# Long random string: python3 -c "import secrets; print(secrets.token_hex(32))"
RUNNER_SECRET_KEY=

# The static IP the scans come from (shown to analysts for the provider heads-up).
RUNNER_SCAN_IP=203.0.113.10

# Email notifications (optional; without SMTP they are only stored and shown to admins).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cyberhealth@example.com
SMTP_STARTTLS=true

# Optional webhook (Slack/Teams-style JSON {"text": ...}).
NOTIFY_WEBHOOK_URL=

# Optional NVD API key (faster CVE date lookups): https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=

# Limits
RUNNER_MAX_WEB_HOSTS=10
RUNNER_MAX_SCAN_HOSTS=16
RUNNER_OWNERSHIP_RECHECK_MINUTES=10
RUNNER_OWNERSHIP_GIVE_UP_DAYS=14

# Branding shown in the sidebar, sign-in page and reports.
RUNNER_BRAND_NAME=BINTARA
RUNNER_BRAND_TAGLINE=We get IT Done. Delivered
RUNNER_BRAND_CONTACT=info@bintara.com.my
